# GEMINI_API_KEY: Required for Gemini AI vision diagnosis, multilingual advice, and agronomy reasoning.
# AI Studio automatically injects this at runtime from user secrets.
# Configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Optional External Services (The app runs in integrated standalone mode by default, or with these configured) ---

# SUPABASE (Optional - for direct cloud database & storage):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"

# RAZORPAY (Optional - for live UPI/card payment checkout):
# RAZORPAY_KEY_ID="rzp_test_xxxxxx"
# RAZORPAY_KEY_SECRET="your-razorpay-secret"

# SMS/OTP & WhatsApp Notifications (Optional - Twilio or MSG91):
# TWILIO_ACCOUNT_SID="ACxxxxxx"
# TWILIO_AUTH_TOKEN="your-twilio-token"
# TWILIO_PHONE_NUMBER="+1234567890"
# TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# MSG91_AUTH_KEY="your-msg91-key"
# MSG91_WHATSAPP_INTEGRATED_NUMBER="919876543210"
